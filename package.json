{
  "name": "humenv",
  "version": "0.2.0",
  "description": "CLI that generates .env, .local.env and .env.example files per service and updates your .gitignore.",
  "type": "module",
  "bin": {
    "humenv": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --clean",
    "dev": "tsx src/index.ts",
    "typecheck": "tsc",
    "test": "vitest run",
    "prepublishOnly": "npm run typecheck && npm run build && npm test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hoshisaiumia/humenv.git"
  },
  "keywords": [
    "env",
    "dotenv",
    "environment",
    "cli",
    "generator",
    "gitignore",
    "env-example"
  ],
  "author": "Hanna Seraphim",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/hoshisaiumia/humenv/issues"
  },
  "homepage": "https://github.com/hoshisaiumia/humenv#readme",
  "devDependencies": {
    "@types/node": "^26.6.5",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.4"
  },
  "dependencies": {
    "@clack/prompts": "^1.8.1"
  }
}
